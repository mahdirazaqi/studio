// Studio — Prisma schema.
//
// Phase 2: Department, User, Session. Phase 4: File. Phase 5: Template,
// TemplateAsset. See docs/data/database.md and docs/architecture/decisions.md
// (ADR-0002, ADR-0006, ADR-0007, ADR-0008, ADR-0011, ADR-0020, ADR-0024,
// ADR-0025, ADR-0027) for the decisions behind this shape. Do not add
// speculative models here — later phases (Jobs, ...) add their own schema
// when those features land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Studio's three fixed roles (docs/domain/authorization.md). No per-action custom
/// roles — a new role is a new ADR, not a new enum value added casually.
enum UserRole {
  USER
  MANAGER
  ADMIN
}

/// Users are never deleted (ADR-0007). This is the entire lifecycle.
enum UserStatus {
  ACTIVE
  DISABLED
}

/// The tenancy / isolation boundary (ADR-0011, docs/domain/departments.md).
///
/// Deletion is an OPEN DECISION (OD-07) and is deliberately NOT implemented — there
/// is no delete path in the application, and `User.departmentId` is a required,
/// `onDelete: Restrict` foreign key, so the database itself refuses to remove a
/// Department that still has Users, even via a manual/administrative query.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  files     File[]
  templates Template[]

  @@map("departments")
}

/// A Studio operator (docs/domain/users.md, ADR-0007).
///
/// Only the fields Phase 2 needs exist here. `phone`, `telegramUserId`,
/// `disabledAt`/`disabledByUserId` etc. are documented as future fields in
/// docs/domain/users.md and are added when the features that need them
/// (Telegram linking, user management/disable UI) are implemented — adding them
/// now would be speculative schema.
model User {
  id           String     @id @default(cuid())
  /// Unique login identifier. Lookups are case-sensitive at the DB level; the
  /// application normalizes to lowercase before every read/write (see
  /// features/auth, features/users).
  email        String     @unique
  fullName     String
  /// Never read/logged/exposed outside the auth feature's credential check.
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  sessions      Session[]
  uploadedFiles File[]

  createdTemplates Template[] @relation("TemplateCreatedBy")
  deletedTemplates Template[] @relation("TemplateDeletedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexed: department-scoped listing/authorization is the dominant future query
  // pattern (ADR-0011). `email` already has an index via its unique constraint.
  // No separate `role` index — cardinality is 3, not selective enough to justify
  // one on its own; add a composite (departmentId, role) later if a real query
  // needs it.
  @@index([departmentId])
  @@map("users")
}

/// A signed-in session (docs/architecture/decisions.md ADR-0020).
///
/// The cookie holds an opaque random token; only its SHA-256 hash is stored here,
/// so a database read alone can never yield a usable session token. A session is
/// valid only while `expiresAt` is in the future AND the linked User is `ACTIVE` —
/// so disabling a User (a later phase's feature) takes effect on every existing
/// session immediately, with no separate revocation sweep required.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// docs/domain/files.md. `GALLERY_ASSET` is the only category any Phase 4 code path
/// creates — `JOB_ARTIFACT` exists so the enum doesn't need a breaking change when
/// the Jobs feature lands (ADR-0024), not because anything produces one yet.
enum FileCategory {
  GALLERY_ASSET
  JOB_ARTIFACT
}

/// Derived from sniffed content, not trusted client input. Drives the allow-list and
/// per-kind size limit in `features/files/domain/file-types.ts`.
enum FileKind {
  IMAGE
  AUDIO
  VIDEO
}

/// An uploaded media asset (docs/domain/files.md, ADR-0008, ADR-0024, ADR-0025).
///
/// Hard-deleted when safe — there is no soft delete and no `deletedAt`. Historical
/// integrity does not rely on this row surviving: a future Job copies the metadata it
/// needs into its own immutable snapshot at creation time (ADR-0010); this row is only
/// the live, deletable Gallery/artifact copy. See ADR-0025 for the exact contract a
/// future Job/Template feature must follow before this model's deletion behavior can
/// be trusted with real dependents.
model File {
  id String @id @default(cuid())

  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  category     FileCategory @default(GALLERY_ASSET)
  kind         FileKind

  /// Client-supplied, display-only. Never used to build a storage path or a shell
  /// command (ADR-0015, Security Requirements §6/§8).
  originalName String
  /// System-generated (`<uuid>.<ext>`) — never derived from `originalName`.
  storedName   String
  /// Opaque location in the storage adapter (ADR-0024). Never sent to the client;
  /// the browser only ever knows this row's `id` and reaches bytes through the
  /// authenticated `/api/files/[fileId]` route, which re-resolves `storageKey`
  /// server-side after an authorization check on every request.
  storageKey   String       @unique

  /// Sniffed from the actual bytes (`file-type`), not the client's declared
  /// Content-Type — see `@/server/media`.
  mimeType String
  sizeBytes Int
  /// SHA-256 hex digest of the bytes. Advisory-dedup groundwork only in Phase 4
  /// (OD-20 stays open) — nothing blocks or auto-merges on a match yet.
  contentHash String

  /// Probed for `IMAGE` only (cheap, pure-JS via `image-size`). Left `null` for
  /// `AUDIO`/`VIDEO` — duration probing needs `ffprobe`, which Phase 4 deliberately
  /// does not introduce (out of scope; see docs/domain/files.md).
  width  Int?
  height Int?

  /// Null for a system-generated artifact (not reachable until Jobs exist).
  uploadedByUserId String?
  uploadedBy       User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  /// Template asset slots that use this File as their default (ADR-0027,
  /// resolves OD-11). Kept only so the deletion-safety check
  /// (`assertNoActiveTemplateDependencies`) has something to query — never
  /// exposed to the client as-is.
  templateAssetDefaults TemplateAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gallery listing (the dominant query: one department's persistent assets, newest
  // first) and the kind filter both need departmentId first for the planner to use
  // either index from the same leading column.
  @@index([departmentId, category, createdAt])
  @@index([departmentId, kind])
  // Advisory dedup lookup (OD-20): "does this department already have this hash".
  @@index([departmentId, contentHash])
  @@map("files")
}

/// A Template's availability for new-job creation (docs/domain/templates.md,
/// Phase 5 brief §7). Deliberately a separate axis from soft deletion
/// (`deletedAt` below) — combining them into one field would conflate "hidden
/// from new jobs, still fully editable" with "retired, kept only for
/// history."
enum TemplateStatus {
  ACTIVE
  DISABLED
}

/// What kind of value a future Job must supply for a slot. `DATA` is literal
/// text; the other three are Gallery File references. Legacy's free-text
/// `type` (plus a server-injected `script` kind never exposed to authors)
/// becomes this validated enum — see docs/domain/templates.md "Asset types".
enum TemplateAssetKind {
  DATA
  IMAGE
  AUDIO
  VIDEO
}

/// Legacy compared floats for aspect-ratio checks (a known bug — see
/// docs/legacy/known-issues.md); Studio validates against a named target with
/// a tolerance, never exact equality. Only meaningful for `TemplateAssetKind.IMAGE`.
enum TemplateImageRatio {
  PORTRAIT_9_16
  LANDSCAPE_16_9
  SQUARE
  ANY
}

/// A reusable render recipe (docs/domain/templates.md, ADR-0006, ADR-0027).
///
/// Soft-deleted only — `deletedAt`/`deletedByUserId` are independent of
/// `status` (Phase 5 brief §7): disabling hides a Template from new-Job
/// creation while it stays fully editable; deleting additionally hides it
/// from management lists. Neither ever removes the row — a future Job's own
/// immutable creation-time snapshot (ADR-0010) is what keeps a historical Job
/// readable, not this row surviving unchanged. Editing a Template never
/// touches an existing Job for the same reason.
///
/// No `youtubeTargetId` field yet: legacy's `_channel` maps to a
/// `YouTubeTarget` concept that has no Prisma model at all (OD-36 is still
/// open, and YouTube delivery is explicitly out of scope for this phase per
/// the Phase 5 brief §16/§35). Adding a column that references a table that
/// doesn't exist would be exactly the speculative schema CLAUDE.md asks to
/// avoid; it is added, as a proper nullable FK, when YouTubeTarget lands.
model Template {
  id String @id @default(cuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  createdByUserId String
  createdBy       User   @relation("TemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Unique per Department among non-deleted rows (ADR-0027, resolves OD-09).
  /// Enforced by a partial unique index added directly in this model's
  /// migration SQL (`WHERE "deletedAt" IS NULL`) — Prisma's schema language
  /// has no first-class syntax for a filtered/partial unique constraint, so
  /// it cannot be declared as an `@@unique` here. See the migration file and
  /// docs/architecture/decisions.md ADR-0027. A plain Postgres unique
  /// violation on that index still surfaces through Prisma as the ordinary
  /// `P2002` error, so the repository's error handling needs no special case
  /// for "the constraint isn't in the schema."
  name String

  status TemplateStatus @default(ACTIVE)

  /// Opaque to Studio — passed through to the Render Worker.
  composition String
  /// Legacy `src` — the Worker's source/project location. Opaque.
  source String
  /// Legacy `script` — injected as the Job's first asset by the Worker
  /// contract. Opaque to Studio.
  scriptRef String
  /// Legacy `output` — output naming/dir pattern, copied into a Job at
  /// creation.
  outputPattern String

  /// Used as the YouTube description on delivery (not implemented yet).
  description String?
  /// YouTube tag templates, with `{{layer}}` placeholders substituted by the
  /// future delivery module — Templates only store the configuration
  /// (Phase 5 brief §16), never perform substitution themselves.
  tags String[] @default([])

  assets TemplateAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soft-delete marker (ADR-0006). `null` = not deleted. Never combined with
  /// `status` — a deleted Template's `status` value is simply irrelevant once
  /// this is set.
  deletedAt DateTime?

  deletedByUserId String?
  deletedBy       User?   @relation("TemplateDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  // Active-template listing/lookup for pickers and management views:
  // department first (the dominant scope filter), then excludes soft-deleted,
  // then status (the active/disabled filter).
  @@index([departmentId, deletedAt, status])
  @@map("templates")
}

/// A slot definition on a Template — what a future Job must supply
/// (docs/domain/templates.md "Template Asset"). Every declared slot is
/// implicitly required to create a Job; there is no optional-slot concept
/// (matches legacy, where every declared asset had to be supplied). The Phase
/// 5 brief's candidate "required/optional" field was deliberately not added —
/// no requirement calls for an optional slot, and Job creation isn't part of
/// this phase regardless.
model TemplateAsset {
  id String @id @default(cuid())

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// Stable slot identifier a future Job fills in — also the only
  /// author-facing label for the slot (legacy `name`). Unique within the
  /// Template. See docs/domain/templates.md "Stable asset identifiers".
  key String

  kind TemplateAssetKind

  /// Passed through to the Job asset the Worker receives. Opaque to Studio.
  composition String
  /// Passed through; also the `{{layer}}` substitution token for tags.
  layer String

  /// Only meaningful for `kind: IMAGE` — enforced at the application layer
  /// (`features/templates/domain`), not by a DB constraint (Postgres has no
  /// built-in cross-column conditional-null check expressible from Prisma
  /// without a raw `CHECK`, and one enum-sized rule doesn't justify a raw SQL
  /// escape hatch here). `null` for every other kind.
  imageRatio TemplateImageRatio?

  /// Optional default Gallery File for this slot (ADR-0027, resolves OD-11).
  /// Only meaningful for `kind: IMAGE | AUDIO | VIDEO` — `null` for `DATA`.
  /// Must belong to the same Department as the Template; enforced at the
  /// application layer on every write (`features/templates/use-cases`), since
  /// Prisma cannot express a cross-row department-equality constraint.
  /// `onDelete: Restrict` here is defense-in-depth only — the primary guard
  /// is `assertNoActiveTemplateDependencies`
  /// (`features/files/use-cases/authorize-file-management.ts`), which the
  /// File-deletion use case calls *before* attempting the delete, so this
  /// Restrict should never actually fire outside a genuine race.
  defaultFileId String?
  defaultFile   File?   @relation(fields: [defaultFileId], references: [id], onDelete: Restrict)

  /// Explicit ordering — rewritten in full on every Template update rather
  /// than diffed (see docs/domain/templates.md "Updating Template assets").
  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([defaultFileId])
  @@map("template_assets")
}
