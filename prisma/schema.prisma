// Studio — Prisma schema.
//
// Phase 2: Department, User, Session. Phase 4: File. Phase 5: Template,
// TemplateAsset. Phase 6: Job, JobAsset. Phase 8: User.phone/telegramUserId,
// TelegramWizardState. See docs/data/database.md and
// docs/architecture/decisions.md (ADR-0002, ADR-0005, ADR-0006, ADR-0007,
// ADR-0008, ADR-0010, ADR-0011, ADR-0013, ADR-0014, ADR-0020, ADR-0024,
// ADR-0025, ADR-0027, ADR-0028, ADR-0029, ADR-0030, ADR-0031, ADR-0035,
// ADR-0036, ADR-0037, ADR-0038) for the decisions behind this shape. Do not
// add speculative models here — later phases (YouTube delivery) add their own
// schema when those features land.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Studio's three fixed roles (docs/domain/authorization.md). No per-action custom
/// roles — a new role is a new ADR, not a new enum value added casually.
enum UserRole {
  USER
  MANAGER
  ADMIN
}

/// Users are never deleted (ADR-0007). This is the entire lifecycle.
enum UserStatus {
  ACTIVE
  DISABLED
}

/// The tenancy / isolation boundary (ADR-0011, docs/domain/departments.md).
///
/// Deletion is an OPEN DECISION (OD-07) and is deliberately NOT implemented — there
/// is no delete path in the application, and `User.departmentId` is a required,
/// `onDelete: Restrict` foreign key, so the database itself refuses to remove a
/// Department that still has Users, even via a manual/administrative query.
model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  files     File[]
  templates Template[]
  jobs      Job[]

  @@map("departments")
}

/// A Studio operator (docs/domain/users.md, ADR-0007).
///
/// `disabledAt`/`disabledByUserId` are still documented-future-only (land with
/// a user management/disable UI, not part of this phase). `phone` and
/// `telegramUserId` land here, Phase 8 (ADR-0035) — see "Telegram linkage"
/// in docs/domain/users.md.
model User {
  id           String     @id @default(cuid())
  /// Unique login identifier. Lookups are case-sensitive at the DB level; the
  /// application normalizes to lowercase before every read/write (see
  /// features/auth, features/users).
  email        String     @unique
  fullName     String
  /// Never read/logged/exposed outside the auth feature's credential check.
  passwordHash String
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)

  /// Normalized digits-only phone number (`features/telegram/domain/phone.ts`
  /// `normalizePhone`), used **only** to match an incoming Telegram "share
  /// contact" against this User (ADR-0035, docs/domain/users.md "Telegram
  /// linkage"). Unique so a phone match can never be ambiguous — resolves the
  /// "ambiguous match" half of OD-06; only the "no match" case remains
  /// possible, handled with a generic rejection. Set today only via
  /// `prisma db seed` / a direct administrative write — there is no
  /// self-service or admin UI to edit it yet (no user-management UI exists;
  /// out of Phase 8's scope, see ADR-0035).
  phone String? @unique

  /// The stable Telegram numeric user id (sent as a string; Telegram ids
  /// exceed JS's safe integer range in principle). Set once, by
  /// `features/telegram/use-cases/link-telegram-account.ts`, after a
  /// successful phone match. `null` = not linked. Unique — one Telegram
  /// identity maps to at most one Studio User (ADR-0035).
  telegramUserId String? @unique

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  sessions      Session[]
  uploadedFiles File[]

  createdTemplates Template[] @relation("TemplateCreatedBy")
  deletedTemplates Template[] @relation("TemplateDeletedBy")

  createdJobs  Job[] @relation("JobCreatedBy")
  canceledJobs Job[] @relation("JobCanceledBy")
  retriedJobs  Job[] @relation("JobRetriedBy")

  /// Ephemeral Telegram conversation state (ADR-0014/ADR-0035) — not a
  /// historical record, unlike everything else this User relates to; see
  /// `TelegramWizardState`'s own doc comment.
  telegramWizardState TelegramWizardState?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexed: department-scoped listing/authorization is the dominant future query
  // pattern (ADR-0011). `email` already has an index via its unique constraint.
  // No separate `role` index — cardinality is 3, not selective enough to justify
  // one on its own; add a composite (departmentId, role) later if a real query
  // needs it. `phone`/`telegramUserId` already have an index via their unique
  // constraints — that's the only lookup either one needs (a single-row match).
  @@index([departmentId])
  @@map("users")
}

/// A signed-in session (docs/architecture/decisions.md ADR-0020).
///
/// The cookie holds an opaque random token; only its SHA-256 hash is stored here,
/// so a database read alone can never yield a usable session token. A session is
/// valid only while `expiresAt` is in the future AND the linked User is `ACTIVE` —
/// so disabling a User (a later phase's feature) takes effect on every existing
/// session immediately, with no separate revocation sweep required.
model Session {
  id        String @id @default(cuid())
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// docs/domain/files.md. `GALLERY_ASSET` is the only category any Phase 4 code path
/// creates — `JOB_ARTIFACT` exists so the enum doesn't need a breaking change when
/// the Jobs feature lands (ADR-0024), not because anything produces one yet.
enum FileCategory {
  GALLERY_ASSET
  JOB_ARTIFACT
}

/// Derived from sniffed content, not trusted client input. Drives the allow-list and
/// per-kind size limit in `features/files/domain/file-types.ts`.
enum FileKind {
  IMAGE
  AUDIO
  VIDEO
}

/// An uploaded media asset (docs/domain/files.md, ADR-0008, ADR-0024, ADR-0025).
///
/// Hard-deleted when safe — there is no soft delete and no `deletedAt`. Historical
/// integrity does not rely on this row surviving: a future Job copies the metadata it
/// needs into its own immutable snapshot at creation time (ADR-0010); this row is only
/// the live, deletable Gallery/artifact copy. See ADR-0025 for the exact contract a
/// future Job/Template feature must follow before this model's deletion behavior can
/// be trusted with real dependents.
model File {
  id String @id @default(cuid())

  departmentId String
  department   Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  category     FileCategory @default(GALLERY_ASSET)
  kind         FileKind

  /// Client-supplied, display-only. Never used to build a storage path or a shell
  /// command (ADR-0015, Security Requirements §6/§8).
  originalName String
  /// System-generated (`<uuid>.<ext>`) — never derived from `originalName`.
  storedName   String
  /// Opaque location in the storage adapter (ADR-0024). Never sent to the client;
  /// the browser only ever knows this row's `id` and reaches bytes through the
  /// authenticated `/api/files/[fileId]` route, which re-resolves `storageKey`
  /// server-side after an authorization check on every request.
  storageKey   String @unique

  /// Sniffed from the actual bytes (`file-type`), not the client's declared
  /// Content-Type — see `@/server/media`.
  mimeType    String
  sizeBytes   Int
  /// SHA-256 hex digest of the bytes. Advisory-dedup groundwork only in Phase 4
  /// (OD-20 stays open) — nothing blocks or auto-merges on a match yet.
  contentHash String

  /// Probed for `IMAGE` only (cheap, pure-JS via `image-size`). Left `null` for
  /// `AUDIO`/`VIDEO` — duration probing needs `ffprobe`, which Phase 4 deliberately
  /// does not introduce (out of scope; see docs/domain/files.md).
  width  Int?
  height Int?

  /// Null for a system-generated artifact (not reachable until Jobs exist).
  uploadedByUserId String?
  uploadedBy       User?   @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)

  /// Template asset slots that use this File as their default (ADR-0027,
  /// resolves OD-11). Kept only so the deletion-safety check
  /// (`assertNoActiveTemplateDependencies`) has something to query — never
  /// exposed to the client as-is.
  templateAssetDefaults TemplateAsset[]

  /// Job assets that resolved this File at creation time (ADR-0028/0031).
  /// `onDelete: SetNull` on `JobAsset.fileId` — a deleted File never breaks a
  /// historical Job, because the identifying metadata is already copied onto
  /// the `JobAsset` row itself, not re-read from here. Kept only so the real
  /// `assertNoActiveJobDependencies` check (Phase 6) has something to query.
  jobAssetReferences JobAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gallery listing (the dominant query: one department's persistent assets, newest
  // first) and the kind filter both need departmentId first for the planner to use
  // either index from the same leading column.
  @@index([departmentId, category, createdAt])
  @@index([departmentId, kind])
  // Advisory dedup lookup (OD-20): "does this department already have this hash".
  @@index([departmentId, contentHash])
  @@map("files")
}

/// A Template's availability for new-job creation (docs/domain/templates.md,
/// Phase 5 brief §7). Deliberately a separate axis from soft deletion
/// (`deletedAt` below) — combining them into one field would conflate "hidden
/// from new jobs, still fully editable" with "retired, kept only for
/// history."
enum TemplateStatus {
  ACTIVE
  DISABLED
}

/// What kind of value a future Job must supply for a slot. `DATA` is literal
/// text; the other three are Gallery File references. Legacy's free-text
/// `type` (plus a server-injected `script` kind never exposed to authors)
/// becomes this validated enum — see docs/domain/templates.md "Asset types".
enum TemplateAssetKind {
  DATA
  IMAGE
  AUDIO
  VIDEO
}

/// Legacy compared floats for aspect-ratio checks (a known bug — see
/// docs/legacy/known-issues.md); Studio validates against a named target with
/// a tolerance, never exact equality. Only meaningful for `TemplateAssetKind.IMAGE`.
enum TemplateImageRatio {
  PORTRAIT_9_16
  LANDSCAPE_16_9
  SQUARE
  ANY
}

/// A reusable render recipe (docs/domain/templates.md, ADR-0006, ADR-0027).
///
/// Soft-deleted only — `deletedAt`/`deletedByUserId` are independent of
/// `status` (Phase 5 brief §7): disabling hides a Template from new-Job
/// creation while it stays fully editable; deleting additionally hides it
/// from management lists. Neither ever removes the row — a future Job's own
/// immutable creation-time snapshot (ADR-0010) is what keeps a historical Job
/// readable, not this row surviving unchanged. Editing a Template never
/// touches an existing Job for the same reason.
///
/// No `youtubeTargetId` field yet: legacy's `_channel` maps to a
/// `YouTubeTarget` concept that has no Prisma model at all (OD-36 is still
/// open, and YouTube delivery is explicitly out of scope for this phase per
/// the Phase 5 brief §16/§35). Adding a column that references a table that
/// doesn't exist would be exactly the speculative schema CLAUDE.md asks to
/// avoid; it is added, as a proper nullable FK, when YouTubeTarget lands.
model Template {
  id String @id @default(cuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  createdByUserId String
  createdBy       User   @relation("TemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Unique per Department among non-deleted rows (ADR-0027, resolves OD-09).
  /// Enforced by a partial unique index added directly in this model's
  /// migration SQL (`WHERE "deletedAt" IS NULL`) — Prisma's schema language
  /// has no first-class syntax for a filtered/partial unique constraint, so
  /// it cannot be declared as an `@@unique` here. See the migration file and
  /// docs/architecture/decisions.md ADR-0027. A plain Postgres unique
  /// violation on that index still surfaces through Prisma as the ordinary
  /// `P2002` error, so the repository's error handling needs no special case
  /// for "the constraint isn't in the schema."
  name String

  status TemplateStatus @default(ACTIVE)

  /// Opaque to Studio — passed through to the Render Worker.
  composition   String
  /// Legacy `src` — the Worker's source/project location. Opaque.
  source        String
  /// Legacy `script` — injected as the Job's first asset by the Worker
  /// contract. Opaque to Studio.
  scriptRef     String
  /// Legacy `output` — output naming/dir pattern, copied into a Job at
  /// creation.
  outputPattern String

  /// Used as the YouTube description on delivery (not implemented yet).
  description String?
  /// YouTube tag templates, with `{{layer}}` placeholders substituted by the
  /// future delivery module — Templates only store the configuration
  /// (Phase 5 brief §16), never perform substitution themselves.
  tags        String[] @default([])

  assets TemplateAsset[]
  jobs   Job[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soft-delete marker (ADR-0006). `null` = not deleted. Never combined with
  /// `status` — a deleted Template's `status` value is simply irrelevant once
  /// this is set.
  deletedAt DateTime?

  deletedByUserId String?
  deletedBy       User?   @relation("TemplateDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  // Active-template listing/lookup for pickers and management views:
  // department first (the dominant scope filter), then excludes soft-deleted,
  // then status (the active/disabled filter).
  @@index([departmentId, deletedAt, status])
  @@map("templates")
}

/// A slot definition on a Template — what a future Job must supply
/// (docs/domain/templates.md "Template Asset"). Every declared slot is
/// implicitly required to create a Job; there is no optional-slot concept
/// (matches legacy, where every declared asset had to be supplied). The Phase
/// 5 brief's candidate "required/optional" field was deliberately not added —
/// no requirement calls for an optional slot, and Job creation isn't part of
/// this phase regardless.
model TemplateAsset {
  id String @id @default(cuid())

  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  /// Stable slot identifier a future Job fills in — also the only
  /// author-facing label for the slot (legacy `name`). Unique within the
  /// Template. See docs/domain/templates.md "Stable asset identifiers".
  key String

  kind TemplateAssetKind

  /// Passed through to the Job asset the Worker receives. Opaque to Studio.
  composition String
  /// Passed through; also the `{{layer}}` substitution token for tags.
  layer       String

  /// Only meaningful for `kind: IMAGE` — enforced at the application layer
  /// (`features/templates/domain`), not by a DB constraint (Postgres has no
  /// built-in cross-column conditional-null check expressible from Prisma
  /// without a raw `CHECK`, and one enum-sized rule doesn't justify a raw SQL
  /// escape hatch here). `null` for every other kind.
  imageRatio TemplateImageRatio?

  /// Optional default Gallery File for this slot (ADR-0027, resolves OD-11).
  /// Only meaningful for `kind: IMAGE | AUDIO | VIDEO` — `null` for `DATA`.
  /// Must belong to the same Department as the Template; enforced at the
  /// application layer on every write (`features/templates/use-cases`), since
  /// Prisma cannot express a cross-row department-equality constraint.
  /// `onDelete: Restrict` here is defense-in-depth only — the primary guard
  /// is `assertNoActiveTemplateDependencies`
  /// (`features/files/use-cases/authorize-file-management.ts`), which the
  /// File-deletion use case calls *before* attempting the delete, so this
  /// Restrict should never actually fire outside a genuine race.
  defaultFileId String?
  defaultFile   File?   @relation(fields: [defaultFileId], references: [id], onDelete: Restrict)

  /// Explicit ordering — rewritten in full on every Template update rather
  /// than diffed (see docs/domain/templates.md "Updating Template assets").
  order Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([templateId, key])
  @@index([defaultFileId])
  @@map("template_assets")
}

/// Job lifecycle (docs/domain/jobs.md, ADR-0013, ADR-0029). Every transition is
/// validated against the fixed graph in `features/jobs/domain/job-state-machine.ts` —
/// nothing outside that module ever writes `Job.state` directly.
///
/// ```
/// QUEUED    → CLAIMED, CANCELED
/// CLAIMED   → RENDERING, QUEUED, ERROR, CANCELED
/// RENDERING → RENDERED, ERROR, CANCELED
/// RENDERED  → DELIVERING, UPLOADED, ERROR
/// DELIVERING→ UPLOADED, ERROR
/// ERROR, UPLOADED, CANCELED → (terminal — no outgoing transitions)
/// ```
enum JobState {
  QUEUED
  CLAIMED
  RENDERING
  RENDERED
  DELIVERING
  UPLOADED
  ERROR
  CANCELED
}

/// What a resolved `JobAsset` actually is. `SCRIPT` is the one kind with no
/// `TemplateAssetKind` counterpart — the Worker-contract script asset Studio
/// injects itself (from the Template's `scriptRef`), never author-supplied.
enum JobAssetKind {
  DATA
  IMAGE
  AUDIO
  VIDEO
  SCRIPT
}

/// One concrete render request — the permanent historical record of the
/// pipeline (ADR-0005). **Never deleted, never soft-deleted, no generic edit.**
/// Only the explicit lifecycle operations in `features/jobs/use-cases/*`
/// (`createJob`, `transitionJob` and its callers, `updateJobProgress`,
/// `updateJobDuration`, `cancelJob`, `retryJob`) ever write to this table.
///
/// Historical integrity (ADR-0028): `snapshot` captures the Template's
/// render-relevant fields and ordered asset-slot definitions **as they were**
/// at creation — immutable, written once, never updated. The per-slot
/// *resolved* values live in the related `JobAsset` rows, which likewise
/// carry their own copied File metadata so a later File deletion can never
/// make a historical Job unreadable (ADR-0025's contract, now real).
model Job {
  id String @id @default(cuid())

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  createdByUserId String
  createdBy       User   @relation("JobCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  /// Kept resolvable forever — Template is soft-deleted only, never hard-deleted,
  /// so this FK always resolves even for a since-deleted/disabled Template. The
  /// *meaning* of a historical Job never depends on this FK, only on `snapshot`
  /// and `JobAsset` — this exists for convenience joins and active-dependency
  /// checks, per ADR-0010's "FK for convenience, snapshot for truth" split.
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  /// Immutable Template-level snapshot, captured once at creation
  /// (ADR-0028): `{ templateName, composition, source, scriptRef,
  /// outputPattern, description, tags, assetSlotDefinitions[] }`. See
  /// `features/jobs/domain/job-snapshot.ts` for the exact shape. Never
  /// updated after creation — there is no code path that writes this field a
  /// second time.
  snapshot Json

  /// Built once at creation from the `DATA`-kind asset values, in Template
  /// slot order, joined with `" | "` (legacy rule, kept). Stored, never
  /// recomputed — editing the Template later must not change a Job's title.
  title String

  state JobState @default(QUEUED)

  /// 0–100, reported by the Worker (not yet — Phase 7). `null` before the
  /// Worker's first report.
  progress        Int?
  /// Rendered output duration in seconds, reported by the Worker. `null`
  /// until reported.
  durationSeconds Int?

  /// Whether this Job's output should be delivered to YouTube on completion
  /// (legacy `upload`). Part of the Job's immutable historical configuration
  /// — an unrelated later Template edit can never change whether an existing
  /// Job uploads. Counted by the daily upload quota (ADR-0030) when `true`.
  deliverToYouTube Boolean @default(false)

  /// Non-destructive retry lineage (ADR-0005, ADR-0031): a retry is a new
  /// Job row; the original is never touched. `onDelete: Restrict` because a
  /// Job is never deleted, so this FK always resolves for the life of the
  /// system.
  retryOfJobId String?
  retryOfJob   Job?    @relation("JobRetryLineage", fields: [retryOfJobId], references: [id], onDelete: Restrict)
  retries      Job[]   @relation("JobRetryLineage")

  /// 1 for an original Job; `retryOfJob.attemptNumber + 1` for a retry.
  attemptNumber Int @default(1)

  retriedByUserId String?
  retriedBy       User?   @relation("JobRetriedBy", fields: [retriedByUserId], references: [id], onDelete: Restrict)
  retryReason     String?

  canceledByUserId String?
  canceledBy       User?     @relation("JobCanceledBy", fields: [canceledByUserId], references: [id], onDelete: Restrict)
  canceledAt       DateTime?
  cancelReason     String?

  /// Human-readable failure reason (render or delivery). Surfaced in the UI —
  /// never a stack trace or internal detail (docs/security/security.md).
  errorReason String?

  /// Lifecycle timeline. All nullable — set by `transitionJob` the first time
  /// the corresponding state is reached; never reset (Studio improvement over
  /// legacy, which zeroed timing fields on cancel — historical integrity
  /// favors keeping the record, resolves part of OD-26).
  claimedAt   DateTime?
  startedAt   DateTime?
  renderedAt  DateTime?
  deliveredAt DateTime?
  uploadedAt  DateTime?

  assets JobAsset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The atomic claim query (`SELECT ... WHERE state = 'QUEUED' ORDER BY
  // "createdAt" FOR UPDATE SKIP LOCKED LIMIT 1`) needs a plain `state` index;
  // department-scoped list/detail pages need departmentId first.
  @@index([state, createdAt])
  @@index([departmentId, state, createdAt])
  @@index([departmentId, createdAt])
  @@index([templateId])
  @@index([retryOfJobId])
  @@map("jobs")
}

/// A single resolved Job asset value — one row per Template asset slot the
/// Job filled in, plus one injected `SCRIPT` row (docs/domain/jobs.md "Job
/// assets"; ADR-0028). Immutable after creation: nothing ever updates a
/// `JobAsset` row once written — a corrected value means a new Job (edit or
/// retry), never an in-place rewrite of history.
model JobAsset {
  id String @id @default(cuid())

  jobId String
  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  /// Matches the originating `TemplateAsset.key` — `null` for the injected
  /// `SCRIPT` row, which has no author-defined slot.
  slotKey String?

  kind JobAssetKind

  /// Passed through to the Worker payload. Opaque to Studio.
  composition String?
  layer       String?

  /// Literal value for `DATA` (and the `SCRIPT` row's `scriptRef`, copied
  /// verbatim from the Template snapshot at creation — never re-read live).
  textValue String?

  /// For file kinds: the resolved File, **at creation time**. `onDelete:
  /// SetNull` — a later File deletion must never break this historical row,
  /// and it doesn't, because every field the Worker/UI needs is already
  /// copied onto this row below, not re-read from `File` (ADR-0025's
  /// contract, ADR-0028).
  fileId           String?
  file             File?   @relation(fields: [fileId], references: [id], onDelete: SetNull)
  fileOriginalName String?
  fileMimeType     String?
  fileSizeBytes    Int?
  fileWidth        Int?
  fileHeight       Int?

  /// Matches the Template asset's declared order; the injected `SCRIPT` row
  /// is always `0`, ahead of every author-defined slot (legacy: script is
  /// `assets[0]`).
  order Int

  createdAt DateTime @default(now())

  // "does any active Job still depend on this File" — the real
  // `assertNoActiveJobDependencies` query (Phase 6) joins through this index.
  @@index([fileId])
  @@index([jobId])
  @@map("job_assets")
}

/// The Telegram conversation flow a wizard row is progressing through
/// (docs/integrations/telegram.md, ADR-0035). `ALBUM` never asks the
/// delivery question (legacy behavior, kept — `docs/domain/jobs.md`'s
/// `deliverToYouTube` defaults to `false` for the whole flow).
enum TelegramWizardFlow {
  SINGLE_TRACK
  ALBUM
}

/// Explicit conversation steps (Phase 8 brief §16) — never an arbitrary
/// string scattered through handlers. `ASK_DELIVERY`/`ASK_TRACK_COUNT` are
/// flow-specific (only `SINGLE_TRACK` uses the former, only `ALBUM` the
/// latter); the rest are shared by both flows.
enum TelegramWizardStep {
  PICK_TEMPLATE
  ASK_DELIVERY
  ASK_TRACK_COUNT
  COLLECT_ASSETS
  CONFIRM
  CREATING
  COMPLETED
}

/// Durable Telegram conversation/wizard state (ADR-0014, ADR-0035) — the
/// direct fix for legacy's `TelegrambotDataset`/`TelegrambotJobDataset`,
/// which were plain in-process `{}` singletons: lost on every restart, not
/// shared across instances, unbounded growth, no TTL.
///
/// Deliberately **not** a historical record like `Job` — this is ephemeral
/// conversational scratch space, TTL'd (`docs/data/lifecycle-rules.md`,
/// `TELEGRAM_WIZARD_TTL_MINUTES`) and lazily expired by the use-case layer on
/// next read (`features/telegram/use-cases/load-active-wizard-state.ts`); a
/// row disappearing changes nothing about any Job/Template/File it may have
/// referenced along the way.
model TelegramWizardState {
  id String @id @default(cuid())

  /// The stable Telegram numeric user id — the natural key for "one active
  /// conversation per Telegram chat", independent of `userId` so a lookup
  /// never needs identity resolution to already have happened.
  telegramUserId String @unique

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  flow TelegramWizardFlow
  step TelegramWizardStep

  /// Validated on every read/write against
  /// `features/telegram/schemas/wizard-payload.schema.ts` — never trusted as
  /// opaque JSON past that boundary (Phase 8 brief §46). Holds only what's
  /// needed to resume the conversation: the chosen Template's id and a
  /// snapshot of its slot definitions (so a mid-conversation Template edit
  /// can't shift the slots being collected), the delivery choice, the track
  /// count, and the asset values collected so far, per track. Never an
  /// arbitrary/unvalidated Telegram update payload.
  payload Json

  /// The most recently processed Telegram update id for this conversation —
  /// defense-in-depth against a duplicate webhook delivery re-advancing the
  /// same step twice (docs/integrations/telegram.md "Duplicate updates").
  lastUpdateId Int?

  createdAt DateTime @default(now())
  /// Drives TTL expiration — a row untouched for longer than
  /// `TELEGRAM_WIZARD_TTL_MINUTES` is treated as expired and lazily deleted
  /// the next time it's read (no separate sweep process — OD-40's durable-work
  /// mechanism doesn't exist yet to hang a scheduled sweep on).
  updatedAt DateTime @updatedAt

  @@map("telegram_wizard_states")
}
