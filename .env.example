# Studio environment configuration
#
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env` or real secrets. Only `.env.example` (placeholders) is committed.
#
# Validation: `src/server/env.ts`. A missing/invalid REQUIRED variable fails the
# process at startup with a clear message. Set SKIP_ENV_VALIDATION=1 to bypass
# (CI type-checks / lint only).

# ---------------------------------------------------------------------------
# Runtime (server-only)
# ---------------------------------------------------------------------------

# "development" | "test" | "production". Usually set by the platform.
NODE_ENV=development

# Log verbosity: "debug" | "info" | "warn" | "error" | "silent"
LOG_LEVEL=debug

# Absolute base URL of this deployment. Optional in development.
# APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Added in later phases (do NOT add before the feature exists):
#
#   DATABASE_URL=postgresql://user:pass@localhost:5432/studio   # Prisma
#   WORKER_API_KEY=...                                          # Render Worker auth
#   TELEGRAM_BOT_TOKEN=...                                      # Telegram bot
#   TELEGRAM_WEBHOOK_SECRET=...                                 # Telegram webhook verification
#   SESSION_SECRET=...                                          # human session signing
#   YOUTUBE_CLIENT_ID / YOUTUBE_CLIENT_SECRET / ...             # YouTube OAuth
#
# Client-exposed variables (browser-visible) MUST be prefixed NEXT_PUBLIC_ and
# must never contain a secret.
# ---------------------------------------------------------------------------
