# Studio environment configuration
#
# Copy to `.env` for local development:  cp .env.example .env
# Never commit `.env` or real secrets. Only `.env.example` (placeholders) is committed.
#
# Validation: `src/server/env.ts`. A missing/invalid REQUIRED variable fails the
# process at startup with a clear message. Set SKIP_ENV_VALIDATION=1 to bypass
# (CI type-checks / lint only).

# ---------------------------------------------------------------------------
# Runtime (server-only)
# ---------------------------------------------------------------------------

# "development" | "test" | "production". Usually set by the platform.
NODE_ENV=development

# Log verbosity: "debug" | "info" | "warn" | "error" | "silent"
LOG_LEVEL=debug

# Absolute base URL of this deployment. Optional in development.
# APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (PostgreSQL + Prisma — ADR-0002)
# ---------------------------------------------------------------------------

# Required. See docs/architecture/database.md for local setup (a disposable
# Docker Postgres is enough for development).
DATABASE_URL=postgresql://studio:studio_dev_password@localhost:5433/studio

# ---------------------------------------------------------------------------
# Authentication / sessions (docs/architecture/authentication.md, ADR-0020)
# ---------------------------------------------------------------------------

# Name of the httpOnly session cookie. Rarely needs changing.
SESSION_COOKIE_NAME=studio_session

# How many days an issued session stays valid.
SESSION_DURATION_DAYS=30

# ---------------------------------------------------------------------------
# File storage (docs/architecture/files.md, ADR-0024)
# ---------------------------------------------------------------------------

# Filesystem root for the local storage adapter. Relative paths resolve against
# the process working directory. Must stay outside `public/` — files are only
# ever served through the authenticated /api/files/[fileId] route.
STORAGE_LOCAL_DIR=.data/storage

# ---------------------------------------------------------------------------
# Jobs (docs/domain/jobs.md, ADR-0029/0030) — both optional, sensible defaults
# ---------------------------------------------------------------------------

# Retry eligibility window in days from the original Job's creation.
# JOB_RETRY_WINDOW_DAYS=3

# Global daily cap on upload-enabled (deliverToYouTube: true) Jobs, UTC day.
# JOB_UPLOAD_DAILY_CAP=3

# ---------------------------------------------------------------------------
# Render Worker (docs/integrations/worker-api.md, ADR-0032) — REQUIRED
# ---------------------------------------------------------------------------

# The Render Worker's shared service credential, sent as `Authorization: Bearer
# <key>` on every /api/worker/v1/** request. A long, random value — generate one
# with `openssl rand -hex 32` or equivalent. Never the placeholder below in a
# real deployment.
WORKER_API_KEY=change-me-to-a-long-random-value-before-deploying

# ---------------------------------------------------------------------------
# Telegram bot (docs/integrations/telegram.md, ADR-0035/0036/0037/0038) —
# OPTIONAL. Studio runs fine with these unset; the webhook route responds
# `dependency` (503) and outbound sends are skipped + logged, rather than the
# whole app failing to start (unlike WORKER_API_KEY, above).
# ---------------------------------------------------------------------------

# Bot token from @BotFather. Required to enable the Telegram bot at all.
# TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# The secret Studio expects on Telegram's X-Telegram-Bot-Api-Secret-Token
# webhook header (pass the same value as `secret_token` when calling
# Telegram's setWebhook). A long, random value — generate one with
# `openssl rand -hex 32` or equivalent. Required whenever TELEGRAM_BOT_TOKEN
# is set.
# TELEGRAM_WEBHOOK_SECRET=change-me-to-a-long-random-value-before-deploying

# Minutes a Telegram conversation may sit untouched before it's treated as
# expired and lazily reset. Default 60.
# TELEGRAM_WIZARD_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Local development seed (prisma/seed.ts) — NEVER set these in a deployed
# environment; the running application never reads them. Leave unset to seed
# only the development Department with no admin user.
# ---------------------------------------------------------------------------

# SEED_DEPARTMENT_NAME=Development
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=change-me-locally   # local-only placeholder, min 8 chars
# SEED_ADMIN_NAME=Development Admin
# SEED_ADMIN_PHONE=989120000000            # lets you link Telegram locally

# ---------------------------------------------------------------------------
# Media processing (docs/integrations/youtube.md "Media processing") —
# OPTIONAL. Defaults to the `ffmpeg` already on PATH.
# ---------------------------------------------------------------------------

# FFMPEG_PATH=ffmpeg

# ---------------------------------------------------------------------------
# YouTube delivery (docs/integrations/youtube.md, ADR-0039) — OPTIONAL. Studio
# runs fine with these unset; connecting a YouTube Target fails with a clear
# error instead of the app failing to start.
# ---------------------------------------------------------------------------

# Google Cloud OAuth client used to exchange a YouTubeTarget's stored refresh
# token for access tokens. Create one in Google Cloud Console (YouTube Data
# API v3 enabled).
# YOUTUBE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# YOUTUBE_CLIENT_SECRET=change-me

# 32 random bytes, base64-encoded — encrypts every YouTubeTarget token at
# rest (AES-256-GCM). Generate with: openssl rand -base64 32
# Rotating this makes previously-connected Targets' tokens unreadable —
# reconnect them after rotating.
# YOUTUBE_TOKEN_ENCRYPTION_KEY=change-me-32-random-bytes-base64

# ---------------------------------------------------------------------------
# Client-exposed variables (browser-visible) MUST be prefixed NEXT_PUBLIC_ and
# must never contain a secret.
# ---------------------------------------------------------------------------
